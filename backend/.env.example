# Copy to backend/.env for local runs. On Render these are set in the dashboard / render.yaml.
DATABASE_URL=sqlite:///./deon.db
ADMIN_KEY=change-me-to-a-long-random-string
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5511
# PayHero: leave blank and set PAYHERO_MOCK=true to test the flow without real money.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_SECRET=another-long-random-string
PAYHERO_MOCK=true
# Resend (emails are skipped and logged when the key is blank)
RESEND_API_KEY=
EMAIL_FROM=Deon Orina <hello@deon.ardena.co.ke>
NOTIFY_EMAIL=ceo@ardena.co.ke
SITE_URL=http://localhost:5511
